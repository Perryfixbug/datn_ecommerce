# Chỉ là ví dụ local; thay thông tin và cấu hình SSL theo database thật.
# Compose PostgreSQL và Prisma CLI cùng đọc apps/api/.env.
# API dùng DATABASE_URL khi chạy; seed chỉ cho phép database PostgreSQL local này.
POSTGRES_USER=app_user
POSTGRES_DB=furniture_ecommerce
POSTGRES_PASSWORD=change_me
DATABASE_URL="postgresql://app_user:change_me@127.0.0.1:55432/furniture_ecommerce?schema=public"
