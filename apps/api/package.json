{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "prisma generate && nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/apps/api/src/main.js",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "prisma generate && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:watch": "prisma generate && node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "clean": "node ../../scripts/clean.mjs dist coverage",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma generate && prisma db seed",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "^1.6.23",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "jose": "^6.2.3",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.2",
    "jest": "^30.5.2",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "5.9.3"
  }
}
